rules_version = '2';

// Comprovantes: só o dono da conta e os membros da conta conjunta leem e gravam.
// A lista de membros e o acesso ativo vêm do Firestore (mesma regra do firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {
    function contaAtiva() {
      return (request.auth.token.email == 'hsrodrigues01@gmail.com' && request.auth.token.email_verified == true)
        || firestore.get(/databases/(default)/documents/acesso/$(request.auth.uid)).data.ativo == true;
    }

    match /usuarios/{userId}/comprovantes/{arquivo} {
      function podeAcessar() {
        return request.auth != null && contaAtiva() && (
          request.auth.uid == userId ||
          firestore.exists(/databases/(default)/documents/usuarios/$(userId)/membros/$(request.auth.uid))
        );
      }
      allow read, delete: if podeAcessar();
      // Só imagens ou PDF, até 10 MB
      allow write: if podeAcessar()
        && (request.resource == null || (request.resource.size < 10 * 1024 * 1024
            && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')));
    }
  }
}
